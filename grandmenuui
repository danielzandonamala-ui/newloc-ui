-- aceita ID numerico, rbxassetid:// ou link (precisa de writefile + getcustomasset no executor)
-- SVG nao e suportado pelo Roblox, entao e ignorado (cai no desenho padrao)
local function ResolveImage(src)
	src = tostring(src or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if src == "" then return "" end
	if src:lower():find("%.svg") then return "" end
	if tonumber(src) then return "rbxassetid://" .. src end
	if src:find("^rbxasset") then return src end
	if src:find("^https?://") then
		if writefile and getcustomasset and isfile and makefolder and isfolder then
			local ok, res = pcall(function()
				if not isfolder("NewlocUI") then makefolder("NewlocUI") end
				if not isfolder("NewlocUI/img") then makefolder("NewlocUI/img") end
				local sum = 0
				for i = 1, #src do sum = (sum * 31 + src:byte(i)) % 4294967291 end
				local path = "NewlocUI/img/" .. sum .. ".png"
				if not isfile(path) then writefile(path, game:HttpGet(src)) end
				return getcustomasset(path)
			end)
			if ok then return res end
		end
	end
	return ""
end

local function Label(w, parent, props, key)
	local p = {
		BackgroundTransparency = 1, Font = FONT, TextSize = 13, TextXAlignment = LEFT,
		Text = "", Parent = parent,
	}
	for k, v in pairs(props or {}) do p[k] = v end
	local l = New("TextLabel", p)
	w:Bind(l, "TextColor3", key or "Text")
	return l
end

-- arrastar (mouse ou dedo). Se soltar sem mover, chama onClick.
-- DICA com o texto completo: registra o texto; Window:_updateTip() descobre sozinho qual texto cortado
-- esta embaixo do mouse (nao depende do evento MouseEnter, que nem sempre dispara). So PC.
-- obj = texto (que pode ser cortado); hit = area que ativa a dica (padrao: o proprio texto; nos controles, a linha inteira)
local function AttachTip(w, obj, getText, padX, hit)
	if w.Mobile or not obj then return end
	table.insert(w.TipTargets, { obj = obj, hit = hit or obj, get = getText or function() return obj.Text end, pad = padX or 0 })
end

local function PlainText(t)
	return (tostring(t):gsub("<[^>]*>", ""))
end

-- o objeto esta realmente visivel (todos os pais visiveis e dentro da area rolavel/cortada)?
local function Shown(obj, root, mouse)
	local p = obj
	while p and p ~= root do
		if p:IsA("GuiObject") then
			if not p.Visible then return false end
			if p ~= obj and (p:IsA("ScrollingFrame") or p.ClipsDescendants) and not Inside(p, mouse) then return false end
		end
		p = p.Parent
	end
	return p == root
end

function Window:_updateTip()
	local tip = self.Tip
	if not tip then return end
	if self.Mobile or self.State ~= "open" or self.Splashing then
		tip.Visible = false
		return
	end
	local now = os.clock()
	if self._tipT and now - self._tipT < 0.04 then return end -- no maximo ~25x por segundo
	self._tipT = now
	local m = UserInputService:GetMouseLocation()
	if self.Main and not Inside(self.Main, m) then
		tip.Visible = false
		return
	end
	local text
	local t = self.TipTargets
	for i = #t, 1, -1 do
		local e = t[i]
		local o = e.obj
		if not o.Parent then
			table.remove(t, i)
		elseif not text and e.hit.Parent and Inside(e.hit, m) and Shown(o, self.Gui, m) then
			local full = PlainText(e.get())
			local ok, size = pcall(function()
				return TextService:GetTextSize(full, o.TextSize, o.Font, Vector2.new(10000, 10000))
			end)
			local sc = self.MainScale and self.MainScale.Scale or 1 -- AbsoluteSize ja vem multiplicado pela escala da janela
			if ok and size.X > o.AbsoluteSize.X / sc - e.pad + 1 then text = full end
		end
	end
	if not text or text == "" then
		tip.Visible = false
		return
	end
	local vp = self.Gui.AbsoluteSize
	local right, bottom = m.X > vp.X * 0.6, m.Y > vp.Y * 0.8
	tip.Text = text
	tip.AnchorPoint = Vector2.new(right and 1 or 0, bottom and 1 or 0)
	tip.Position = UDim2.fromOffset(m.X + (right and -12 or 14), m.Y + (bottom and -12 or 18))
	tip.Visible = true
end

local function MakeDraggable(w, handle, target, onClick)
	local dragging, moved, startP, startPos, dragInput = false, false, nil, nil, nil
	local threshold = w.Mobile and 10 or 4
	w:Connect(handle.InputBegan, function(i)
		if IsPress(i) then
			dragging, moved, dragInput = true, false, i
			startP, startPos = Pointer(i), target.Position
		end
	end)
	w:Connect(UserInputService.InputChanged, function(i)
		if dragging and Tracks(dragInput, i) then
			local d = Pointer(i) - startP
			if d.Magnitude > threshold then moved = true end
			if moved then
				local us = target:FindFirstChildOfClass("UIScale")
				d = d / (us and us.Scale or 1)
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end
	end)
	w:Connect(UserInputService.InputEnded, function(i)
		if dragging and Ends(dragInput, i) then
			dragging, dragInput = false, nil
			if not moved and onClick then onClick() end
		end
	end)
end

-- icones desenhados com formas (estilo Lucide, nao dependem de fonte/emoji/imagem)
-- kinds: x, min, search, check, info, copy, panel-close, panel-open
local function DrawIcon(w, parent, kind, key)
	local c = New("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Parent = parent })
	local function paint(inst, prop)
		if typeof(key) == "Color3" then inst[prop] = key else w:Bind(inst, prop, key) end
	end
	local function bar(bw, bh, x, y, rot)
		local f = New("Frame", { Size = UDim2.fromOffset(bw, bh), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Rotation = rot or 0, BorderSizePixel = 0, Parent = c })
		paint(f, "BackgroundColor3")
		Round(f, 1)
	end
	local function ring(wd, x, y, th, rad, ht)
		local r = New("Frame", { Size = UDim2.fromOffset(wd, ht or wd), Position = UDim2.fromOffset(x, y), BackgroundTransparency = 1, Parent = c })
		Round(r, rad or wd)
		local st = Stroke(r, Color3.new(1, 1, 1), th)
		paint(st, "Color")
	end
	if kind == "x" then
		bar(14, 2, 8, 8, 45)
		bar(14, 2, 8, 8, -45)
	elseif kind == "min" then
		bar(12, 2, 8, 8)
	elseif kind == "search" then
		ring(11, 0, 0, 2)
		bar(6, 2, 12.5, 12.5, 45)
	elseif kind == "check" then
		bar(5, 2, 4.5, 9, 45)
		bar(10, 2, 9.5, 7.5, -50)
	elseif kind == "info" then
		-- lucide info: circulo + traco + ponto
		ring(15, 0.5, 0.5, 1.5)
		bar(1.6, 2.8, 8, 9.6)
		bar(1.8, 1.8, 8, 5.2)
	elseif kind == "copy" then
		-- lucide copy: quadrado da frente + "L" de tras
		bar(8.6, 1.6, 6, 1.4)
		bar(1.6, 8.6, 1.4, 6)
		bar(1.6, 3, 10.2, 2.8)
		ring(9.5, 5.5, 5.5, 1.6, 2.5)
	elseif kind == "panel-close" then
		-- lucide panel-left-close: moldura + divisoria + seta <
		ring(14, 1, 1, 1.6, 3)
		bar(1.6, 12.4, 5.5, 8)
		bar(3.6, 1.6, 10.75, 6.75, -45)
		bar(3.6, 1.6, 10.75, 9.25, 45)
	elseif kind == "panel-open" then
		-- lucide panel-left-open: moldura + divisoria + seta >
		ring(14, 1, 1, 1.6, 3)
		bar(1.6, 12.4, 5.5, 8)
		bar(3.6, 1.6, 9.75, 6.75, 45)
		bar(3.6, 1.6, 9.75, 9.25, -45)
	end
	return c
end

-- icone dos botoes: png (SOURCE.ButtonIcon) ou desenho padrao
local fpAsset, fpLoading
local function GetFingerprint()
	if fpAsset ~= nil then return fpAsset end
	while fpLoading do
		task.wait()
		if fpAsset ~= nil then return fpAsset end
	end
	fpLoading = true
	fpAsset = ResolveImage(SOURCE.ButtonIcon)
	fpLoading = false
	return fpAsset
end

-- impressao digital SEM quadrado de fundo, na cor de destaque
local function AddFingerprint(w, parent)
	local holder = New("Frame", { Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Parent = parent })
	task.spawn(function()
		local img = GetFingerprint()
		if not holder.Parent then return end
		if img ~= "" then
			local il = New("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = img, ScaleType = Enum.ScaleType.Fit, Parent = holder })
			w:Bind(il, "ImageColor3", "Accent")
		else
			-- aneis concentricos com "cortes" (parece impressao digital)
			local rings = { { 18, 20 }, { 14, 110 }, { 10, 200 }, { 6, 290 } }
			for _, r in ipairs(rings) do
				local f = New("Frame", { Size = UDim2.fromOffset(r[1], r[1]), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Parent = holder })
				Round(f, r[1])
				local st = Stroke(f, w.Theme.Accent, 1.5)
				w:Bind(st, "Color", "Accent")
				New("UIGradient", {
					Rotation = r[2],
					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 0),
						NumberSequenceKeypoint.new(0.61, 1), NumberSequenceKeypoint.new(0.78, 1),
						NumberSequenceKeypoint.new(0.79, 0), NumberSequenceKeypoint.new(1, 0),
					}),
					Parent = st,
				})
			end
			local dot = New("Frame", { Size = UDim2.fromOffset(3, 3), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BorderSizePixel = 0, Parent = holder })
			w:Bind(dot, "BackgroundColor3", "Accent")
			Round(dot, 2)
		end
	end)
	return holder
end

------------------------------------------------------------------ janela: base

function Window:Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self.Conns, c)
	return c
end

function Window:Bind(inst, prop, key)
	table.insert(self.Binds, { inst, prop, key })
	inst[prop] = self.Theme[key]
end

function Window:SetColor(key, color)
	if not self.Theme[key] then return end
	self.Theme[key] = color
	for _, b in ipairs(self.Binds) do
		if b[3] == key and b[1].Parent then b[1][b[2]] = color end
	end
	for _, fn in ipairs(self.Refreshers) do pcall(fn) end
end

function Window:AddOpaque(inst)
	table.insert(self.Opaque, inst)
	inst.BackgroundTransparency = 1 - self.Opacity
end

function Window:SetOpacity(v)
	self.Opacity = math.clamp(v, 0.3, 1)
	for _, inst in ipairs(self.Opaque) do
		if inst.Parent then inst.BackgroundTransparency = 1 - self.Opacity end
	end
end

function Window:SetState(s)
	self.State = s
	if self.Tip then self.Tip.Visible = false end
	self.Main.Visible = (s == "open") and not self.Splashing
	self.Pill.Visible = (s == "minimized") and not self.Splashing
	-- mobile: sem teclado nao da pra reabrir com a tecla, entao o botao flutuante aparece quando oculto
	if self.Float then self.Float.Visible = (s == "hidden") and not self.Splashing and self.FloatEnabled end
end

function Window:Toggle()
	if self.Splashing then return end
	if self.State == "hidden" then
		self:SetState(self.LastState or "open")
	else
		self.LastState = self.State
		self:SetState("hidden")
	end
end

function Window:Minimize()
	self:SetState(self.State == "minimized" and "open" or "minimized")
end

-- botao flutuante (reabre o menu quando oculto). No mobile fica sempre ligado (senao nao ha como reabrir).
function Window:SetFloatEnabled(v)
	if self.Mobile then v = true end
	self.FloatEnabled = v and true or false
	self:SetState(self.State)
end

-- tamanho da janela (0.5 a 1.3). O limite real e o que cabe na tela (ver _applyLayout).
function Window:SetScale(v)
	self.UserScale = math.clamp(tonumber(v) or 1, 0.5, 1.3)
	if self.W then self:_applyLayout(false) end
end

-- tecla padrao (K): minimiza / restaura. Se estiver oculto, volta ao estado anterior.
function Window:ToggleMinimize()
	if self.Splashing then return end
	if self.State == "open" then
		self:SetState("minimized")
	elseif self.State == "minimized" then
		self:SetState("open")
	else
		self:SetState(self.LastState or "open")
	end
end

-- aplica a geometria da barra lateral conforme o estado (recolhida/expandida) e o modo (gaveta ou lado a lado)
function Window:_applySide(instant)
	local c = self.SideCollapsed and true or false
	local wd = c and 0 or self.SideW
	local ov = self.SideOverlay
	local sizeSide = UDim2.new(0, wd, 1, -self.SideTop)
	local posC = ov and UDim2.fromOffset(0, 0) or UDim2.fromOffset(wd, 0)
	local sizeC = ov and UDim2.fromScale(1, 1) or UDim2.new(1, -wd, 1, 0)
	if instant then
		self.Side.Size, self.Content.Position, self.Content.Size = sizeSide, posC, sizeC
		self.Side.Visible = not c
	else
		if not c then self.Side.Visible = true end
		Tween(self.Side, { Size = sizeSide }, 0.2)
		Tween(self.Content, { Position = posC, Size = sizeC }, 0.2)
		if c then
			task.delay(0.22, function()
				if self.SideCollapsed and self.Side.Parent then self.Side.Visible = false end
			end)
		end
	end
	self.IconClose.Visible = not c
	self.IconOpen.Visible = c
end

-- recolhe / expande a barra lateral
function Window:SetSidebarCollapsed(c, instant)
	c = c and true or false
	if (self.SideCollapsed and true or false) == c and not instant then return end
	self.SideCollapsed = c
	self:_applySide(instant)
end

function Window:Destroy()
	for _, c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
	self.Gui:Destroy()
end

function Window:Copy(text)
	local f = setclipboard or toclipboard
	if f then
		pcall(f, tostring(text))
		self:Notify({ Title = "NEWLOC", Content = "Copiado para a área de transferência.", Duration = 2 })
	else
		self:Notify({ Title = "NEWLOC", Content = "Seu executor não suporta copiar.", Duration = 2 })
	end
end

function Window:Notify(o)
	o = o or {}
	self.NotifyCount = (self.NotifyCount or 0) + 1
	local f = New("CanvasGroup", {
		Size = UDim2.new(1, 0, 0, 58), BackgroundColor3 = self.Theme.Card, GroupTransparency = 1,
		LayoutOrder = self.NotifyCount, Parent = self.NotifyHolder,
	})
	Round(f, 10)
	Stroke(f, self.Theme.Accent, 1)
	local ic = New("Frame", {
		Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(12, 15), BackgroundColor3 = self.Theme.Accent, Parent = f,
	})
	Round(ic, 14)
	DrawIcon(self, ic, "check", Color3.new(1, 1, 1))
	New("TextLabel", {
		Size = UDim2.new(1, -60, 0, 18), Position = UDim2.fromOffset(52, 10), BackgroundTransparency = 1, Font = FONTB,
		TextSize = 13, TextXAlignment = LEFT, TextColor3 = self.Theme.Text, Text = tostring(o.Title or "NEWLOC"),
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = f,
	})
	New("TextLabel", {
		Size = UDim2.new(1, -60, 0, 18), Position = UDim2.fromOffset(52, 29), BackgroundTransparency = 1, Font = FONT,
		TextSize = 12, TextXAlignment = LEFT, TextColor3 = self.Theme.SubText, Text = tostring(o.Content or ""),
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = f,
	})
	Tween(f, { GroupTransparency = 0 }, 0.25)
	task.delay(o.Duration or 3, function()
		if f.Parent then
			Tween(f, { GroupTransparency = 1 }, 0.3).Completed:Wait()
			f:Destroy()
		end
	end)
end

