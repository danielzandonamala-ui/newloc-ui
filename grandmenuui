	w.NameLabel = Label(w, card, { Size = UDim2.new(1, -(textX + 34), 0, 18), Position = UDim2.fromOffset(textX, m and 6 or 10), Text = w.Nick, Font = FONTB, TextSize = m and 12 or 13, TextTruncate = Enum.TextTruncate.AtEnd })
	Label(w, card, { Size = UDim2.new(1, -(textX + 34), 0, 16), Position = UDim2.fromOffset(textX, m and 24 or 30), Text = "ID: " .. LocalPlayer.UserId, TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd }, "SubText")
	local ib = New("Frame", { Size = UDim2.fromOffset(20, CH), Position = UDim2.new(1, -24, 0, 0), BackgroundTransparency = 1, Parent = card })
