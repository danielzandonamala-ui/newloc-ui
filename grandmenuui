	w:Bind(w.StatsFrame, "BackgroundColor3", "Background")
	Round(w.StatsFrame, 5)
	local sst = Stroke(w.StatsFrame, w.Theme.Accent, 1)
	w:Bind(sst, "Color", "Accent")
	local statsLabel = Label(w, w.StatsFrame, { Size = UDim2.fromOffset(0, 24), AutomaticSize = AUTOX, Text = "FPS: --", Font = FONTB, TextSize = 12 })
	Pad(statsLabel, 8, 0, 8, 0)
	local acc, frames = 0, 0
	w:Connect(RunService.RenderStepped, function(dt)
		acc += dt
		frames += 1
		if acc >= 0.5 then
			w.FPS = math.floor(frames / acc + 0.5)
			acc, frames = 0, 0
			pcall(function() w.Ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
			if w.StatsFrame.Visible then
				statsLabel.Text = string.format("FPS: %d  |  Ping: %dms  |  Jogadores: %d", w.FPS, w.Ping, #Players:GetPlayers())
			end
		end
	end)

	-- pill (minimizado)
	w.Pill = New("Frame", { Size = UDim2.fromOffset(0, m and 40 or 36), AutomaticSize = AUTOX, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, m and 56 or 20), Visible = false, Active = true, Parent = gui })
	w:Bind(w.Pill, "BackgroundColor3", "Background")
	Round(w.Pill, 20)
	local pst = Stroke(w.Pill, w.Theme.Accent, 1.5)
	w:Bind(pst, "Color", "Accent")
	w.PillLabel = Label(w, w.Pill, { Size = UDim2.fromOffset(0, m and 40 or 36), AutomaticSize = AUTOX, Text = string.upper(w.Title), Font = FONTX, TextSize = 14 })
	Pad(w.PillLabel, 18, 0, 18, 0)
	MakeDraggable(w, w.Pill, w.Pill, function() w:SetState("open") end)

	-- botao flutuante: aparece quando o menu esta oculto. Toque/clique = reabrir, arrastar = mover.
	-- (no mobile e sempre ligado; no PC pode ser desligado em Configuracoes)
	do
		w.Float = New("TextButton", {
			Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(48, 48), AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.4, 0), Visible = false, Active = true, ZIndex = 60, Parent = gui,
		})
		w:Bind(w.Float, "BackgroundColor3", "Background")
		Round(w.Float, 24)
		local fst = Stroke(w.Float, w.Theme.Accent, 1.5)
		w:Bind(fst, "Color", "Accent")
		w.FloatImg = New("ImageLabel", {
			Size = UDim2.fromOffset(30, 30), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit, Image = "", Visible = false, Parent = w.Float,
		})
		w.FloatText = Label(w, w.Float, {
			Size = UDim2.fromScale(1, 1), Text = string.upper(string.sub(w.Title, 1, 1)), Font = FONTX, TextSize = 22, TextXAlignment = CENTER,
		}, "Accent")
		MakeDraggable(w, w.Float, w.Float, function() w:SetState(w.LastState or "open") end)
	end

	-- modal de informacoes
	local modal = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, Visible = false, ZIndex = 50, Active = true, Parent = main })
	Round(modal, 12)
	local panel = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(430, 340), Parent = modal })
	w.InfoPanel = panel
	w:Bind(panel, "BackgroundColor3", "Card")
	Round(panel, 12)
	local pnst = Stroke(panel, w.Theme.Accent, 1)
	w:Bind(pnst, "Color", "Accent")
	Label(w, panel, { Size = UDim2.new(1, -60, 0, 36), Position = UDim2.fromOffset(16, 4), Text = "Informações", Font = FONTB, TextSize = 16 })
	local XB = m and 32 or 26
	local xb = New("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(XB, XB), Position = UDim2.new(1, -(XB + 10), 0, (44 - XB) / 2), Parent = panel })
	w:Bind(xb, "BackgroundColor3", "Element")
	Round(xb, 7)
	DrawIcon(w, xb, "x", "Text")
	xb.MouseButton1Click:Connect(function() modal.Visible = false end)

	local ibH = m and 32 or 28
	local listY = 44 + ibH + 8
	local infoTabsBar = New("Frame", { Size = UDim2.new(1, -32, 0, ibH), Position = UDim2.fromOffset(16, 44), BackgroundTransparency = 1, Parent = panel })
	List(infoTabsBar, 6, Enum.FillDirection.Horizontal)
	local infoList = New("ScrollingFrame", {
		Size = UDim2.new(1, -32, 1, -(listY + 8)), Position = UDim2.fromOffset(16, listY), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = AUTOY, Parent = panel,
	})
	w:Bind(infoList, "ScrollBarImageColor3", "Accent")
	List(infoList, 4)

	task.spawn(function()
		local okk, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, game.PlaceId)
		if okk and info then w.GameName = info.Name end
	end)

	local function fmtTime(sec)
		sec = math.floor(sec)
		return string.format("%02d:%02d:%02d", sec // 3600, sec % 3600 // 60, sec % 60)
	end
	local infoTabs = {
		Jogador = function()
			local ch = LocalPlayer.Character
			local hum = ch and ch:FindFirstChildOfClass("Humanoid")
			local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
			return {
				{ "Nickname (menu)", w.Nick }, { "Usuário", LocalPlayer.Name }, { "Display name", LocalPlayer.DisplayName },
				{ "User ID", LocalPlayer.UserId }, { "Idade da conta", LocalPlayer.AccountAge .. " dias" },
				{ "Premium", LocalPlayer.MembershipType == Enum.MembershipType.Premium and "Sim" or "Não" },
				{ "Vida", hum and string.format("%d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth)) or "-" },
				{ "Velocidade", hum and math.floor(hum.WalkSpeed) or "-" },
				{ "Posição", hrp and string.format("%d, %d, %d", math.floor(hrp.Position.X), math.floor(hrp.Position.Y), math.floor(hrp.Position.Z)) or "-" },
			}
		end,
		Jogo = function()
			return {
				{ "Nome", w.GameName or "carregando..." }, { "Place ID", game.PlaceId }, { "Game ID", game.GameId },
				{ "Versão do place", game.PlaceVersion },
			}
		end,
		Servidor = function()
			return {
				{ "Job ID", game.JobId ~= "" and game.JobId or "(Studio)" },
				{ "Jogadores", #Players:GetPlayers() .. " / " .. Players.MaxPlayers },
				{ "Ping", w.Ping .. " ms" }, { "FPS", w.FPS },
				{ "Tempo do servidor", fmtTime(workspace.DistributedGameTime) },
				{ "Servidor privado", game.PrivateServerId ~= "" and "Sim" or "Não" },
			}
		end,
	}
	local infoOrder = { "Jogador", "Jogo", "Servidor" }
	local curInfo = "Jogador"
	local rowsCache, infoBtns = {}, {}

	local function renderInfo()
		local data = infoTabs[curInfo]()
		for i, item in ipairs(data) do
			local r = rowsCache[i]
			if not r then
				local f = New("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, m and 32 or 28), BackgroundTransparency = 0.6, LayoutOrder = i, Parent = infoList })
				w:Bind(f, "BackgroundColor3", "Element")
				Round(f, 6)
				local l = Label(w, f, { Size = UDim2.new(0.38, 0, 1, 0), Position = UDim2.fromOffset(10, 0), TextSize = m and 12 or 13 }, "SubText")
				local v = Label(w, f, { Size = UDim2.new(0.62, -44, 1, 0), Position = UDim2.new(0.38, 10, 0, 0), TextXAlignment = RIGHT, TextTruncate = Enum.TextTruncate.AtEnd, TextSize = m and 12 or 13 })
				-- botao de copiar (icone lucide copy) ao lado do valor
				local cp = New("TextButton", {
					Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromOffset(m and 30 or 24, m and 30 or 24),
					AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Parent = f,
				})
				local cpIcon = DrawIcon(w, cp, "copy", "SubText")
				local cpScale = New("UIScale", { Parent = cpIcon })
				Hover(w, cp, function() Tween(cpScale, { Scale = 1.2 }, 0.1) end, function() Tween(cpScale, { Scale = 1 }, 0.1) end)
				cp.MouseButton1Click:Connect(function() w:Copy(v.Text) end)
				f.MouseButton1Click:Connect(function() w:Copy(v.Text) end)
				r = { f = f, l = l, v = v }
				rowsCache[i] = r
			end
			r.f.Visible = true
			r.l.Text = item[1]
			r.v.Text = tostring(item[2])
		end
		for i = #data + 1, #rowsCache do rowsCache[i].f.Visible = false end
	end
	local function styleInfoTabs()
		for name, b in pairs(infoBtns) do
			b.BackgroundColor3 = (name == curInfo) and w.Theme.Accent or w.Theme.Element
			b.TextColor3 = (name == curInfo) and Color3.new(1, 1, 1) or w.Theme.SubText
		end
	end
	for _, name in ipairs(infoOrder) do
		local b = New("TextButton", {
			Text = name, Font = FONTB, TextSize = 12, AutoButtonColor = false,
			Size = m and UDim2.new(1 / 3, -4, 1, 0) or UDim2.fromOffset(92, 28), Parent = infoTabsBar,
		})
		Round(b, 7)
		infoBtns[name] = b
		b.MouseButton1Click:Connect(function() curInfo = name styleInfoTabs() renderInfo() end)
	end
	table.insert(w.Refreshers, styleInfoTabs)
	styleInfoTabs()

	card.MouseButton1Click:Connect(function()
		modal.Visible = not modal.Visible
		if modal.Visible then
			task.spawn(function()
				while modal.Visible and gui.Parent do
					renderInfo()
					task.wait(1)
				end
			end)
		end
	end)

	-- tecla global (K por padrao): minimiza / restaura o menu
	w:Connect(UserInputService.InputBegan, function(input, gpe)
		if gpe or input.UserInputType ~= Enum.UserInputType.Keyboard or w.Listening then return end
		if input.KeyCode == w.ToggleKey then
			w:ToggleMinimize()
			return
		end
		for _, kb in ipairs(w.Keybinds) do
			if kb.Key == input.KeyCode and kb.Callback then task.spawn(kb.Callback, kb.Key) end
		end
	end)

	-- inicial
	w:SetLogo(SOURCE.Logo)
	w:SetBanner(SOURCE.Banner)
	w:SetAvatar(o.Avatar)
	w:_applyLayout(true)
	w:_refreshBanner()

	-- girou a tela / mudou o tamanho: reajusta tudo
	local cam = workspace.CurrentCamera
	if cam then
		w:Connect(cam:GetPropertyChangedSignal("ViewportSize"), function() w:_applyLayout(false) end)
	end

	if o.Settings ~= false then w:_buildSettings() end
	if SOURCE.Splash and SOURCE.Splash.Enabled then w:_splash() end
	return w
end

return Library
