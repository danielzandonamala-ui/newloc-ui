------------------------------------------------------------------ helpers

local function New(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	if parent then inst.Parent = parent end
	return inst
end

local function Tween(obj, props, t)
	local tw = TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function Round(inst, r)
	return New("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = inst })
end

local function Stroke(inst, color, th)
	return New("UIStroke", { Color = color, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inst })
end

local function Pad(inst, l, t, r, b)
	t = t or l
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r or l), PaddingBottom = UDim.new(0, b or t), Parent = inst,
	})
end

local function List(inst, pad, dir)
	return New("UIListLayout", {
		Padding = UDim.new(0, pad or 0), SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = dir or Enum.FillDirection.Vertical, Parent = inst,
	})
end

local function ToHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function FromHex(s)
	s = (tostring(s):gsub("#", ""):gsub("%s", ""))
	if #s == 3 then s = s:sub(1, 1):rep(2) .. s:sub(2, 2):rep(2) .. s:sub(3, 3):rep(2) end
	if #s ~= 6 or not tonumber(s, 16) then return nil end
	return Color3.fromRGB(tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16))
end

local function Escape(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function Mouse()
	return UserInputService:GetMouseLocation()
end

local function IsPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

-- ponto p (Vector2) esta dentro do GuiObject g?
local function Inside(g, p)
	local a, s = g.AbsolutePosition, g.AbsoluteSize
	return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
end

-- o toque/clique (input) caiu dentro do GuiObject g?
-- Testa varias formas de coordenada (com e sem o inset da barra do topo, mouse e toque)
-- e considera "dentro" se QUALQUER uma bater. Assim nunca fecha por engano.
local function PressedInside(input, g)
	if not g or not g.Parent then return false end
	local p = input.Position
	local inset = GuiService:GetGuiInset()
	local candidates = {
		Mouse(),
		Vector2.new(p.X, p.Y),
		Vector2.new(p.X + inset.X, p.Y + inset.Y),
	}
	for _, v in ipairs(candidates) do
		if Inside(g, v) then return true end
	end
	return false
end

------------------------------------------------------------------ helpers de toque (mobile)

-- Em toque, o Roblox pode entregar a posicao com ou sem o "inset" da barra do topo.
-- TouchMode guarda qual dos dois bate com o AbsolutePosition da GUI. Ele se auto-corrige:
-- sempre que um toque comeca num elemento pequeno (menor que o inset), vemos qual formato
-- cai dentro dele e lembramos. Assim sliders / seletor de cor ficam certos em qualquer aparelho.
local TouchMode = "inset"

local function Calibrate(input, g)
	if not g or input.UserInputType ~= Enum.UserInputType.Touch then return end
	local p = Vector2.new(input.Position.X, input.Position.Y)
	local inset = GuiService:GetGuiInset()
	local withInset, raw = Inside(g, p + inset), Inside(g, p)
	if withInset and not raw then TouchMode = "inset" elseif raw and not withInset then TouchMode = "raw" end
end

-- posicao do ponteiro no mesmo espaco do AbsolutePosition (mouse OU toque)
local function Pointer(input)
	if input and input.UserInputType == Enum.UserInputType.Touch then
		local p = Vector2.new(input.Position.X, input.Position.Y)
		if TouchMode == "inset" then return p + GuiService:GetGuiInset() end
		return p
	end
	return UserInputService:GetMouseLocation()
end

-- liga a calibracao num elemento (chame em botoes/sliders pequenos)
local function Calib(g)
	if g then g.InputBegan:Connect(function(i) Calibrate(i, g) end) end
end

-- o InputChanged "i" pertence ao arraste que comecou com "dragInput"?
local function Tracks(dragInput, i)
	if not dragInput then return false end
	if dragInput.UserInputType == Enum.UserInputType.Touch then return i == dragInput end
	return i.UserInputType == Enum.UserInputType.MouseMovement
end

-- o InputEnded "i" encerra o arraste que comecou com "dragInput"?
local function Ends(dragInput, i)
	if not dragInput then return false end
	if dragInput.UserInputType == Enum.UserInputType.Touch then
		return i == dragInput or dragInput.UserInputState == Enum.UserInputState.End
	end
	return i.UserInputType == dragInput.UserInputType
end

-- hover so existe no PC (no toque o MouseEnter dispara e nunca "sai", deixando o item preso)
local function Hover(w, obj, enter, leave)
	if w.Mobile then return end
	obj.MouseEnter:Connect(enter)
	obj.MouseLeave:Connect(leave)
end

-- trava a rolagem da pagina enquanto arrasta slider / seletor de cor
local function LockScroll(page, lock)
	if page and page.Parent then page.ScrollingEnabled = not lock end
end

