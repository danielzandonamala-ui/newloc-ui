function Section:CreateLabel(text)
	local w = self.Window
	local l = Label(w, self.Card, { Size = UDim2.new(1, 0, 0, 20), Text = tostring(text), TextWrapped = true, RichText = true, AutomaticSize = AUTOY, LayoutOrder = self:_next() }, "SubText")
	self:_reg(l, text)
	return { Set = function(_, t) l.Text = tostring(t) end }
end

-- Botao: SEM quadrado. Mostra so o icone (impressao digital, ou "copy" com Icon = "copy").
-- No mobile a linha inteira e clicavel.
function Section:CreateButton(o)
	local w = self.Window
	local m = w.Mobile
	local row = self:_row(o.Name, nil, nil, (w.Mobile and 54 or 40))
	local us
	local function act()
		if m and us then
			us.Scale = 1.3
			Tween(us, { Scale = 1 }, 0.15)
		end
		fire(o.Callback)
	end
	RowTap(w, row, act)
	local b = New("TextButton", {
		Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
		Size = m and UDim2.fromOffset(46, 36) or UDim2.fromOffset(32, 24),
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Parent = row,
	})
	Calib(b)
	local icon
	if o.Icon == "copy" then
		icon = DrawIcon(w, b, "copy", "Accent")
	else
		icon = AddFingerprint(w, b)
	end
	us = New("UIScale", { Parent = icon })
	Hover(w, b, function() Tween(us, { Scale = 1.2 }, 0.1) end, function() Tween(us, { Scale = 1 }, 0.1) end)
	b.MouseButton1Click:Connect(act)
	return { Button = b }
end

