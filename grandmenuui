-- posiciona logo / titulo / lista de abas conforme o modo (PC, mobile compacto ou gaveta)
function Window:_layoutLogo()
	local has = self.LogoImage.Image ~= ""
	local m, ov = self.Mobile, self.SideOverlay
	local top
	if ov then
		-- gaveta: so a lista de abas + card do jogador
		self.LogoImage.Visible, self.TitleLabel.Visible, self.SubLabel.Visible = false, false, false
		top = 6
	elseif m then
		-- mobile lado a lado: logo e titulo menores, sem subtitulo
		self.TitleLabel.Visible, self.SubLabel.Visible = true, false
		self.LogoImage.Size = UDim2.fromOffset(40, 40)
		self.LogoImage.Position = UDim2.new(0.5, 0, 0, 8)
		self.LogoImage.Visible = has
		self.TitleLabel.Size = UDim2.new(1, -16, 0, 24)
		self.TitleLabel.Position = UDim2.fromOffset(8, has and 52 or 14)
		top = (has and 52 or 14) + 24 + 6
	else
		self.TitleLabel.Visible, self.SubLabel.Visible = true, true
		self.LogoImage.Size = UDim2.fromOffset(60, 60)
		self.LogoImage.Position = UDim2.new(0.5, 0, 0, 12)
		self.LogoImage.Visible = has
		self.TitleLabel.Size = UDim2.new(1, -20, 0, 30)
		self.SubLabel.Size = UDim2.new(1, -20, 0, 16)
		if has then
			self.TitleLabel.Position, self.SubLabel.Position = UDim2.fromOffset(10, 76), UDim2.fromOffset(10, 104)
		else
			self.TitleLabel.Position, self.SubLabel.Position = UDim2.fromOffset(10, 40), UDim2.fromOffset(10, 72)
		end
		top = 138
	end
	local cardH = m and 46 or 58
	self.TabList.Position = UDim2.fromOffset(0, top)
	self.TabList.Size = UDim2.new(1, 0, 1, -(top + cardH + 20))
	if self.Float then
		local img = self.LogoImage.Image
		self.FloatImg.Image = img
		self.FloatImg.Visible = img ~= ""
		self.FloatText.Visible = img == ""
	end
end

function Window:SetLogo(src)
