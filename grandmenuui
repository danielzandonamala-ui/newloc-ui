function Section:CreateSlider(o)
	local w = self.Window
	local m = w.Mobile
	local page = self.Tab.Page
	local min, max = o.Range[1], o.Range[2]
	local inc = o.Increment or 1
	local row, label = self:_row(o.Name)
	label.Size = UDim2.new(0.38, -8, 1, 0)
	local val = Label(w, row, {
		Size = UDim2.new(0, 48, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), TextXAlignment = RIGHT,
	})
	local TKH, KS = m and 8 or 6, m and 20 or 14
	local track = New("Frame", {
		Size = UDim2.new(0.62, -72, 0, TKH), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0.38, 0.5), Parent = row,
	})
	w:Bind(track, "BackgroundColor3", "Stroke")
	Round(track, TKH / 2)
	local fill = New("Frame", { Size = UDim2.fromScale(0, 1), Parent = track })
	w:Bind(fill, "BackgroundColor3", "Accent")
	Round(fill, TKH / 2)
	local knob = New("Frame", {
		Size = UDim2.fromOffset(KS, KS), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = Color3.fromRGB(245, 245, 250), Parent = fill,
	})
	Round(knob, KS / 2)
	local hit = New("TextButton", {
		Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, m and 40 or 24), AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5), Parent = track,
	})
	Calib(hit)

	local function snap(v)
		v = math.clamp(v, min, max)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		return math.clamp(tonumber(string.format("%.6g", v)), min, max)
	end
	local obj = { Value = snap(o.CurrentValue or min) }
	local function render()
		fill.Size = UDim2.fromScale((obj.Value - min) / (max - min), 1)
		val.Text = tostring(obj.Value) .. (o.Suffix or "")
	end
	function obj:Get() return self.Value end
	function obj:Set(v, silent)
		self.Value = snap(tonumber(v) or min)
		w.Flags[self.Flag] = self.Value
		render()
		if not silent then fire(o.Callback, self.Value) end
	end
	local dragging, dragInput = false, nil
	local function update(i)
		local a = math.clamp((Pointer(i).X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = snap(min + (max - min) * a)
		if v ~= obj.Value then obj:Set(v, o.OnRelease) end
	end
	w:Connect(hit.InputBegan, function(i)
		if IsPress(i) then
			dragging, dragInput = true, i
			LockScroll(page, true)
			update(i)
		end
	end)
	w:Connect(UserInputService.InputChanged, function(i)
		if dragging and Tracks(dragInput, i) then update(i) end
	end)
	w:Connect(UserInputService.InputEnded, function(i)
		if dragging and Ends(dragInput, i) then
			dragging, dragInput = false, nil
			LockScroll(page, false)
			if o.OnRelease then fire(o.Callback, obj.Value) end
		end
	end)
	self:_register(obj, o, "slider")
	render()
	return obj
end

local function BuildChoice(self, o, kind)
	local w = self.Window
	local obj = { Options = o.Options or {}, Value = o.CurrentValue }
	if obj.Value == nil then obj.Value = obj.Options[1] end
	return obj, w
end

-- Dropdown: so abre/fecha clicando no botao dele (ou escolhendo um item).
-- NAO fecha sozinho ao clicar em outros lugares (a menos que a janela tenha CloseOnOutsideClick = true).
-- Use CloseOnSelect = false para a lista continuar aberta depois de escolher um item.
function Section:CreateDropdown(o)
	local obj, w = BuildChoice(self, o)
	local m = w.Mobile
	local box = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTOY, BackgroundTransparency = 1, LayoutOrder = self:_next(), Parent = self.Card })
	List(box, 4)
	local row = self:_row(o.Name, nil, box, (not w.Mobile) and 148 or nil)
	self:_reg(box, o.Name)
	local list
	RowTap(w, row, function() list.Visible = not list.Visible end)
	local btn = New("TextButton", {
		Text = "", AutoButtonColor = false, Size = self:_ctl(140, 24), AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0), Parent = row,
	})
	Calib(btn)
	w:Bind(btn, "BackgroundColor3", "Background")
	Round(btn, 6)
	local txt = Label(w, btn, { Size = UDim2.new(1, -26, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd })
	Label(w, btn, { Size = UDim2.new(0, 16, 1, 0), Position = UDim2.new(1, -20, 0, 0), Text = "v", Font = FONTB, TextSize = 11, TextXAlignment = CENTER }, "SubText")
	AttachTip(w, txt, function() return txt.Text end, 0, btn)
	list = New("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 8), AutomaticSize = Enum.AutomaticSize.None, Visible = false, LayoutOrder = 2,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = AUTOY, ScrollBarThickness = 3, BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.Y, ClipsDescendants = true, Parent = box,
	})
	w:Bind(list, "BackgroundColor3", "Background")
	Round(list, 6)
	Pad(list, 4)
	List(list, 2)

	local function render()
		txt.Text = obj.Value ~= nil and tostring(obj.Value) or "Nenhum"
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then
				c.TextColor3 = (c.Text == tostring(obj.Value)) and w.Theme.Accent or w.Theme.Text
			end
		end
	end
	local function build()
		local keepPos = list.CanvasPosition
		for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
		for i, opt in ipairs(obj.Options) do
			local b = New("TextButton", {
				Text = tostring(opt), Font = FONT, TextSize = m and 13 or 12, BackgroundTransparency = 1, AutoButtonColor = false,
				Size = UDim2.new(1, -8, 0, m and 32 or 24), LayoutOrder = i, Parent = list,
				TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = LEFT,
			})
			New("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = b })
			AttachTip(w, b, function() return b.Text end, 16)
			Hover(w, b,
				function() b.BackgroundTransparency = 0.85 b.BackgroundColor3 = w.Theme.Accent end,
				function() b.BackgroundTransparency = 1 end)
			b.MouseButton1Click:Connect(function()
				obj:Set(opt)
				if o.CloseOnSelect ~= false then list.Visible = false end
			end)
		end
		-- altura da lista: ate ~6 opcoes visiveis, o resto rola
		list.Size = UDim2.new(1, 0, 0, math.min(#obj.Options * ((m and 32 or 24) + 2) + 8, m and 200 or 164))
		render()
		-- reconstruir a lista (ex.: selecao multipla) nao pode jogar a rolagem de volta ao topo
		task.defer(function()
			if list.Parent then list.CanvasPosition = keepPos end
		end)
	end
	function obj:Get() return self.Value end
	function obj:Set(v, silent)
		self.Value = v
		w.Flags[self.Flag] = v
		render()
		if not silent then fire(o.Callback, v) end
	end
	function obj:SetOptions(opts)
		self.Options = opts
		build()
	end
	btn.MouseButton1Click:Connect(function()
		list.Visible = not list.Visible
	end)
	-- opcional: clicar fora fecha a lista (desligado por padrao)
	if w.CloseOnOutsideClick then
		w:Connect(UserInputService.InputBegan, function(i)
			if list.Visible and IsPress(i) then
				if not PressedInside(i, list) and not PressedInside(i, btn) then list.Visible = false end
			end
		end)
	end
	table.insert(w.Refreshers, render)
	self:_register(obj, o, "dropdown")
	build()
	return obj
end

function Section:CreateSelector(o)
	local obj, w = BuildChoice(self, o)
	local m = w.Mobile
	local AW = m and 30 or 24
	local row = self:_row(o.Name, nil, nil, (not w.Mobile) and 168 or nil)
	local box = New("Frame", {
		Size = self:_ctl(160, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Parent = row,
	})
	w:Bind(box, "BackgroundColor3", "Background")
	Round(box, 6)
	local function arrow(txt, pos)
		local b = New("TextButton", {
			Text = txt, Font = FONTB, TextSize = 14, BackgroundTransparency = 1, Size = UDim2.new(0, AW, 1, 0),
			Position = pos, Parent = box,
		})
		w:Bind(b, "TextColor3", "SubText")
		return b
	end
	local prev, nxt = arrow("<", UDim2.fromOffset(0, 0)), arrow(">", UDim2.new(1, -AW, 0, 0))
	local txt = Label(w, box, { Size = UDim2.new(1, -(AW * 2), 1, 0), Position = UDim2.fromOffset(AW, 0), TextXAlignment = CENTER, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd })
	local function index()
		for i, v in ipairs(obj.Options) do if v == obj.Value then return i end end
		return 1
	end
	function obj:Get() return self.Value end
	function obj:Set(v, silent)
		self.Value = v
		txt.Text = tostring(v)
		w.Flags[self.Flag] = v
		if not silent then fire(o.Callback, v) end
	end
	local function step(d)
		local n = #obj.Options
		if n == 0 then return end
		obj:Set(obj.Options[(index() - 1 + d) % n + 1])
	end
	prev.MouseButton1Click:Connect(function() step(-1) end)
	nxt.MouseButton1Click:Connect(function() step(1) end)
	self:_register(obj, o, "selector")
	txt.Text = tostring(obj.Value)
	return obj
end

