-- Keybind: no PC captura a tecla. No MOBILE (sem teclado) vira um botao "Ativar" que dispara o Callback.
function Section:CreateKeybind(o)
	local w = self.Window
	local m = w.Mobile
	local row = self:_row(o.Name, nil, nil, (w.Mobile and 104 or 100))
	local btn = New("TextButton", {
		Size = m and UDim2.fromOffset(96, 30) or UDim2.fromOffset(92, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Font = FONTB, TextSize = 12, AutoButtonColor = false, Text = "", Parent = row,
	})
	w:Bind(btn, "BackgroundColor3", "Background")
	w:Bind(btn, "TextColor3", "Accent")
	Round(btn, 6)
	local obj = { Key = nil }
	local function toKey(v)
		if typeof(v) == "EnumItem" then return v end
		if type(v) == "string" and v ~= "None" then
			local ok, k = pcall(function() return Enum.KeyCode[v] end)
			if ok and k then return k end
			local ok2, u = pcall(function() return Enum.UserInputType[v] end)
			return ok2 and u or nil
		end
		return nil
	end
	obj.Key = toKey(o.CurrentValue)
	obj.Callback = o.Callback
	local function showText()
		if m then
			btn.Text = o.Callback and "Ativar" or "Só teclado"
		else
			btn.Text = obj.Key and obj.Key.Name or "Nenhuma"
		end
	end
	function obj:Get() return self.Key and self.Key.Name or "None" end
	function obj:Set(v, silent)
		local ok, k = pcall(toKey, v)
		self.Key = ok and k or nil
		showText()
		w.Flags[self.Flag] = self:Get()
		if not silent then fire(o.OnChanged, self.Key) end
	end
	if m then
		btn.MouseButton1Click:Connect(function()
			if o.Callback then fire(o.Callback, obj.Key) end
		end)
	else
		btn.MouseButton1Click:Connect(function()
			if w.Listening then return end
			w.Listening = true
			btn.Text = "..."
			local c
			c = UserInputService.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.Keyboard then
					c:Disconnect()
					if i.KeyCode == Enum.KeyCode.Backspace then obj:Set(nil) elseif i.KeyCode ~= Enum.KeyCode.Escape then obj:Set(i.KeyCode) else obj:Set(obj.Key, true) end
					task.delay(0.15, function() w.Listening = false end)
				end
			end)
		end)
	end
	if o.Callback then table.insert(w.Keybinds, obj) end
	self:_register(obj, o, "keybind")
	showText()
	return obj
end

-- Seletor de cor: so abre/fecha clicando na caixinha de cor (ou Esc).
-- NAO fecha sozinho ao clicar no quadrado, na barra de matiz, no hex ou nas cores rapidas
-- (a menos que a janela tenha CloseOnOutsideClick = true).
function Section:CreateColorPicker(o)
	local w = self.Window
	local m = w.Mobile
	local page = self.Tab.Page
	local box = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTOY, BackgroundTransparency = 1, LayoutOrder = self:_next(), Parent = self.Card })
	List(box, 4)
	local row = self:_row(o.Name, nil, box, (w.Mobile and 64 or 54))
	self:_reg(box, o.Name)
	local panel
	RowTap(w, row, function() panel.Visible = not panel.Visible end)
	local preview = New("TextButton", {
		Text = "", AutoButtonColor = false, Size = m and UDim2.fromOffset(56, 28) or UDim2.fromOffset(46, 20), AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), Parent = row,
	})
	Calib(preview)
	Round(preview, 5)
	local pst = Stroke(preview, w.Theme.Stroke, 1)
	w:Bind(pst, "Color", "Stroke")

	-- medidas (no PC ficam iguais ao original: painel de 192)
	local svH = m and 110 or 100
	local hueY = 8 + svH + 8
	local hueH = m and 18 or 12
	local hexY = hueY + hueH + 8
	local hexH = m and 28 or 22
	local swY = hexY + hexH + 8
	local swS = m and 20 or 16
	local panelH = swY + (swS + 2) + 8

	panel = New("Frame", { Size = UDim2.new(1, 0, 0, panelH), Visible = false, LayoutOrder = 2, Parent = box })
	w:Bind(panel, "BackgroundColor3", "Background")
	Round(panel, 8)

	-- quadrado saturacao / brilho
	local sv = New("Frame", { Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, svH), BackgroundColor3 = Color3.new(1, 0, 0), ClipsDescendants = true, Parent = panel })
	Round(sv, 4)
	local white = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sv })
	New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
	local black = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = sv })
	New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
	local CS = m and 14 or 10
	local svCursor = New("Frame", { Size = UDim2.fromOffset(CS, CS), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 5, Parent = sv })
	Round(svCursor, CS / 2)
	Stroke(svCursor, Color3.new(1, 1, 1), 2)
	local svHit = New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 6, Parent = sv })

	-- barra de matiz
	local hue = New("Frame", { Position = UDim2.fromOffset(8, hueY), Size = UDim2.new(1, -16, 0, hueH), BackgroundColor3 = Color3.new(1, 1, 1), Parent = panel })
	Round(hue, hueH / 2)
	New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)), ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)), ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)), ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hue,
	})
	local hueCursor = New("Frame", { Size = UDim2.new(0, m and 6 or 4, 1, 6), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), Parent = hue })
	Round(hueCursor, 2)
	Stroke(hueCursor, Color3.new(0, 0, 0), 1)
	local hueExtra = m and 16 or 8
	local hueHit = New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, hueExtra), Position = UDim2.fromOffset(0, -hueExtra / 2), Parent = hue })
	Calib(hueHit)

	-- hex
	local hex = New("TextBox", {
		Position = UDim2.fromOffset(8, hexY), Size = UDim2.new(1, -16, 0, hexH), Font = FONT, TextSize = m and 13 or 12,
		ClearTextOnFocus = false, Text = "#FFFFFF", Parent = panel,
	})
	w:Bind(hex, "BackgroundColor3", "Element")
	w:Bind(hex, "TextColor3", "Text")
	Round(hex, 5)

	-- paleta rapida (estilo paint)
	local sw = New("Frame", { Position = UDim2.fromOffset(8, swY), Size = UDim2.new(1, -16, 0, swS + 2), BackgroundTransparency = 1, Parent = panel })
	List(sw, 3, Enum.FillDirection.Horizontal)

	local obj = { Value = Color3.new(1, 1, 1) }
	local h, s, v = 0, 0, 1
	local function apply(silent)
		local c = Color3.fromHSV(h, s, v)
		obj.Value = c
		preview.BackgroundColor3 = c
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.fromScale(s, 1 - v)
		hueCursor.Position = UDim2.fromScale(h, 0.5)
		if not hex:IsFocused() then hex.Text = ToHex(c) end
		if obj.Flag then w.Flags[obj.Flag] = ToHex(c) end
		if not silent then fire(o.Callback, c) end
	end
	function obj:Get() return ToHex(self.Value) end
	function obj:Set(c, silent)
		if typeof(c) == "string" then c = FromHex(c) end
		if typeof(c) ~= "Color3" then return end
		local nh, ns, nv = c:ToHSV()
		if ns > 0 and nv > 0 then h = nh end
		s, v = ns, nv
		apply(silent)
	end

	for _, col in ipairs(Swatches) do
		local b = New("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(swS, swS), BackgroundColor3 = col, Parent = sw })
		Round(b, 4)
		Stroke(b, w.Theme.Stroke, 1)
		b.MouseButton1Click:Connect(function() obj:Set(col) end)
	end

	local drag, dragInput
	local function upd(i)
		local p = Pointer(i)
		if drag == "sv" then
			s = math.clamp((p.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
			v = 1 - math.clamp((p.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
			apply()
		elseif drag == "hue" then
			h = math.clamp((p.X - hue.AbsolutePosition.X) / math.max(hue.AbsoluteSize.X, 1), 0, 0.999)
			apply()
		end
	end
	w:Connect(svHit.InputBegan, function(i)
		if IsPress(i) then
			drag, dragInput = "sv", i
			LockScroll(page, true)
			upd(i)
		end
	end)
	w:Connect(hueHit.InputBegan, function(i)
		if IsPress(i) then
			drag, dragInput = "hue", i
			LockScroll(page, true)
			upd(i)
		end
	end)
	w:Connect(UserInputService.InputChanged, function(i)
		if drag and Tracks(dragInput, i) then upd(i) end
	end)
	w:Connect(UserInputService.InputEnded, function(i)
		if drag and Ends(dragInput, i) then
			drag, dragInput = nil, nil
			LockScroll(page, false)
		end
	end)
	hex.FocusLost:Connect(function()
		local c = FromHex(hex.Text)
		if c then obj:Set(c) else hex.Text = ToHex(obj.Value) end
	end)
	preview.MouseButton1Click:Connect(function() panel.Visible = not panel.Visible end)

	-- Esc fecha. Clicar fora so fecha se a janela tiver CloseOnOutsideClick = true.
	w:Connect(UserInputService.InputBegan, function(i)
		if not panel.Visible then return end
		if i.KeyCode == Enum.KeyCode.Escape then
			panel.Visible = false
		elseif w.CloseOnOutsideClick and IsPress(i) then
			if not PressedInside(i, panel) and not PressedInside(i, preview) then panel.Visible = false end
		end
	end)

	local start = o.CurrentValue or o.Default or Color3.new(1, 1, 1)
	if typeof(start) == "string" then start = FromHex(start) or Color3.new(1, 1, 1) end
	local nh, ns, nv = start:ToHSV()
	h, s, v = nh, ns, nv
	self:_register(obj, o, "color")
	apply(true)
	return obj
end

------------------------------------------------------------------ aba de configuracoes (automatica)

function Window:_buildSettings()
	local w = self
	local tab = w:CreateTab({ Name = "Configurações", Icon = "⚙", Order = 1000, IsSettings = true })

	-- personalizacao
	local p = tab:CreateSection("Personalização")
	p:CreateInput({ Name = "Nickname", Flag = "cfg/nick", CurrentValue = w.Nick, Callback = function(t) w:SetNickname(t) end })
	p:CreateInput({ Name = "Foto de perfil", Flag = "cfg/avatar", Placeholder = "ID / link (vazio = padrão)", Callback = function(t) w:SetAvatar(t) end })
	p:CreateSlider({ Name = "Opacidade do menu", Flag = "cfg/opacity", Range = { 30, 100 }, CurrentValue = 100, Suffix = "%", Callback = function(v) w:SetOpacity(v / 100) end })
	p:CreateToggle({ Name = "Mostrar FPS / Ping", Flag = "cfg/stats", CurrentValue = false, Callback = function(v) w.StatsFrame.Visible = v end })
	-- slider de tamanho: PC e mobile (aplica ao soltar, para o slider nao "pular" enquanto a janela muda de tamanho)
	p:CreateSlider({
		Name = "Tamanho do menu", Flag = "cfg/scale", Range = { 50, 130 }, Increment = 5, CurrentValue = 100, Suffix = "%",
		OnRelease = true, Callback = function(v) w:SetScale(v / 100) end,
	})
	-- botao flutuante: no PC da pra desligar (no mobile e sempre ligado, senao nao tem como reabrir o menu)
	if not w.Mobile then
		p:CreateToggle({ Name = "Botão flutuante (ao ocultar)", Flag = "cfg/float", CurrentValue = w.FloatEnabled, Callback = function(v) w:SetFloatEnabled(v) end })
	end

	-- cores
	local c = tab:CreateSection("Cores")
	c:CreateSelector({
		Name = "Tema rápido", Options = PresetOrder, CurrentValue = "Roxo", Save = false,
		Callback = function(n)
			local el = w.Elements["cfg/color/Accent"]
			if el and Presets[n] then el:Set(Presets[n]) end
		end,
	})
	for _, item in ipairs(ThemeOrder) do
		local key = item[1]
		c:CreateColorPicker({
			Name = item[2], Flag = "cfg/color/" .. key, CurrentValue = DefaultTheme[key],
			Callback = function(col) w:SetColor(key, col) end,
		})
	end
	c:CreateButton({
		Name = "Restaurar cores padrão",
		Callback = function()
			for key, col in pairs(DefaultTheme) do
				local el = w.Elements["cfg/color/" .. key]
				if el then el:Set(col) end
			end
		end,
	})

	-- teclas / janela
	local k = tab:CreateSection("Teclas e janela")
	if w.Mobile then
		k:CreateLabel("Para reabrir depois de ocultar, toque no botão flutuante.")
	else
		k:CreateKeybind({
			Name = "Minimizar / restaurar menu", Flag = "cfg/togglekey", CurrentValue = w.ToggleKey,
			OnChanged = function(key)
				if key then w.ToggleKey = key else w.Elements["cfg/togglekey"]:Set(w.ToggleKey, true) end
			end,
		})
	end
	k:CreateButton({ Name = "Ocultar menu agora", Callback = function() w:SetState("hidden") w.LastState = "open" end })
	k:CreateButton({ Name = "Minimizar", Callback = function() w:SetState("minimized") end })
	k:CreateButton({ Name = "Recolher / expandir barra lateral", Callback = function() w:SetSidebarCollapsed(not w.SideCollapsed) end })

	-- config
	local f = tab:CreateSection("Configuração")
	local nameIn = f:CreateInput({ Name = "Nome da config", CurrentValue = "default", Save = false })
	local drop
	local function refreshList() if drop then drop:SetOptions(w:ListConfigs()) end end
	drop = f:CreateDropdown({
		Name = "Configs salvas", Options = w:ListConfigs(), CurrentValue = nil, Save = false,
		Callback = function(v) if v then nameIn:Set(v, true) end end,
	})
	f:CreateButton({ Name = "Atualizar lista", Callback = refreshList })
	f:CreateButton({
		Name = "Salvar config",
		Callback = function()
			local ok, err = w:SaveConfig(nameIn:Get())
			w:Notify({ Title = ok and "Config salva" or "Erro", Content = ok and CleanName(nameIn:Get()) or tostring(err), Duration = 3 })
			refreshList()
		end,
	})
	f:CreateButton({
		Name = "Carregar config",
		Callback = function()
			local ok, err = w:LoadConfig(nameIn:Get())
			w:Notify({ Title = ok and "Config carregada" or "Erro", Content = ok and CleanName(nameIn:Get()) or tostring(err), Duration = 3 })
		end,
	})
	f:CreateButton({
		Name = "Deletar config",
		Callback = function()
			w:DeleteConfig(nameIn:Get())
			w:Notify({ Title = "Config deletada", Content = CleanName(nameIn:Get()), Duration = 3 })
			refreshList()
		end,
	})
	local txt = f:CreateInput({ Name = "Texto da config", Placeholder = "Exporte ou cole aqui", Save = false })
	f:CreateButton({
		Name = "Exportar (copiar)", Icon = "copy",
		Callback = function()
			local s = w:ExportConfig()
			txt:Set(s, true)
			w:Copy(s)
		end,
	})
	f:CreateButton({
		Name = "Importar (colar acima)",
		Callback = function()
			local ok = w:ImportConfig(txt:Get())
			w:Notify({ Title = ok and "Config importada" or "Erro", Content = ok and "Tudo aplicado." or "Texto inválido.", Duration = 3 })
		end,
	})
	f:CreateButton({ Name = "Resetar tudo", Callback = function() w:ResetAll() end })
end

------------------------------------------------------------------ splash (tela de abertura)

function Window:_splash()
	local w, S = self, SOURCE.Splash
	w.Splashing = true
	w.Main.Visible = false
	if w.Float then w.Float.Visible = false end
	task.spawn(function()
		local img = ResolveImage(S.Image)
		local cam = workspace.CurrentCamera
		local vpx = cam and cam.ViewportSize.X or 1280
		local group = New("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, ZIndex = 100, Parent = w.Gui })
		New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, BorderSizePixel = 0, Parent = group })
		local panel = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(math.min(380, vpx - 30), 200),
			BackgroundColor3 = w.Theme.Card, Parent = group,
		})
		Round(panel, 14)
		Stroke(panel, w.Theme.Accent, 1.5)
		local hasImg = img ~= ""
		if hasImg then
			New("ImageLabel", { Size = UDim2.fromOffset(48, 48), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit, Image = img, Parent = panel })
		end
		local t = New("TextLabel", {
			Size = UDim2.new(1, -40, 0, 38), Position = UDim2.fromOffset(20, hasImg and 66 or 40), BackgroundTransparency = 1,
			Text = S.Title, Font = FONTX, TextSize = 30, TextScaled = true, TextColor3 = w.Theme.Text, Parent = panel,
		})
		New("UITextSizeConstraint", { MaxTextSize = 30, MinTextSize = 12, Parent = t })
		New("TextLabel", {
			Size = UDim2.new(1, -40, 0, 20), Position = UDim2.fromOffset(20, hasImg and 108 or 84), BackgroundTransparency = 1,
			Text = S.Subtitle, Font = FONT, TextSize = 14, TextColor3 = w.Theme.SubText, Parent = panel,
		})
		local track = New("Frame", { Size = UDim2.new(0.7, 0, 0, 5), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 160), BackgroundColor3 = w.Theme.Stroke, Parent = panel })
		Round(track, 3)
		local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = w.Theme.Accent, Parent = track })
		Round(fill, 3)

		local dur = S.Duration or 2.5
		Tween(group, { GroupTransparency = 0 }, 0.35)
		TweenService:Create(fill, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { Size = UDim2.fromScale(1, 1) }):Play()
		task.wait(dur)
		Tween(group, { GroupTransparency = 1 }, 0.35)
		task.wait(0.4)
		group:Destroy()
		w.Splashing = false
		w:SetState(w.State)
	end)
end

------------------------------------------------------------------ criar janela

function Library:CreateWindow(o)
	o = o or {}
	local mobile
	if o.Mobile ~= nil then mobile = o.Mobile and true or false else mobile = DetectMobile() end
	local singleCol = mobile
	if o.SingleColumn ~= nil then singleCol = o.SingleColumn and true or false end

	local w = setmetatable({
		Theme = table.clone(DefaultTheme), Flags = {}, Elements = {}, Binds = {}, Refreshers = {}, Opaque = {},
		Tabs = {}, Conns = {}, Keybinds = {}, TipTargets = {},
		ToggleKey = o.ToggleKey or Enum.KeyCode.K,
		CloseOnOutsideClick = o.CloseOnOutsideClick == true,
		Mobile = mobile, SingleCol = singleCol,
		ReqW = o.Width or 800, ReqH = o.Height or 500, W = 800, H = 500,
		SideW = 190, SideTop = 0, SideOverlay = false,
		TB = mobile and 32 or 28, TopH = mobile and 44 or 48,
		State = "open", Opacity = 1, SideCollapsed = false,
		Title = SOURCE.Title, Subtitle = SOURCE.Subtitle,
		Nick = o.Nickname or LocalPlayer.DisplayName,
		WelcomeText = SOURCE.WelcomeText,
		WelcomeSub = SOURCE.WelcomeSub,
		FPS = 0, Ping = 0,
		UserScale = 1, FloatEnabled = (o.FloatButton ~= false),
	}, Window)
	if mobile then w.FloatEnabled = true end
	local m = mobile
	local TB, TOPH = w.TB, w.TopH

	-- gui
	local gui = New("ScreenGui", { Name = "NewlocUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, DisplayOrder = 999 })
	local ok = false
	if gethui then ok = pcall(function() gui.Parent = gethui() end) end
	if not ok then ok = pcall(function() gui.Parent = CoreGui end) end
	if not ok then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
	for _, g in ipairs(gui.Parent:GetChildren()) do
		if g ~= gui and g.Name == "NewlocUI" then g:Destroy() end
	end
	w.Gui = gui

	-- dica flutuante (texto completo de itens cortados)
	local tip = New("TextLabel", {
		Name = "Tip", Visible = false, ZIndex = 1000, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 0),
		BackgroundTransparency = 0, BorderSizePixel = 0, Font = FONT, TextSize = 12, TextWrapped = true,
		TextXAlignment = LEFT, Text = "", Active = false, Parent = gui,
	})
	New("UISizeConstraint", { MaxSize = Vector2.new(320, 400), Parent = tip })
	Pad(tip, 8, 5, 8, 5)
	Round(tip, 6)
	local tipStroke = Stroke(tip, w.Theme.Stroke, 1)
	w:Bind(tip, "BackgroundColor3", "Background")
	w:Bind(tip, "TextColor3", "Text")
	w:Bind(tipStroke, "Color", "Stroke")
	w.Tip = tip
	w:Connect(UserInputService.InputChanged, function(i)
		if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.MouseWheel then
			w:_updateTip()
		end
	end)

	-- tamanho/posicao reais sao definidos em _applyLayout (no fim da criacao)
	local main = New("Frame", { Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(w.W, w.H), Parent = gui })
	w.Main = main
	w.MainScale = New("UIScale", { Parent = main })
	w:Bind(main, "BackgroundColor3", "Background")
	w:AddOpaque(main)
	Round(main, 12)
	local mst = Stroke(main, w.Theme.Stroke, 1)
	w:Bind(mst, "Color", "Stroke")

	-- sidebar
	local side = New("Frame", { Size = UDim2.new(0, 190, 1, 0), ClipsDescendants = true, Parent = main })
	w.Side = side
	w:Bind(side, "BackgroundColor3", "Sidebar")
	w:AddOpaque(side)
	Round(side, 12)
	local filler = New("Frame", { Size = UDim2.new(0, 14, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), BorderSizePixel = 0, Parent = side })
	w:Bind(filler, "BackgroundColor3", "Sidebar")
	w:AddOpaque(filler)
	local sep = New("Frame", { Size = UDim2.new(0, 1, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), BorderSizePixel = 0, Parent = side })
	w:Bind(sep, "BackgroundColor3", "Stroke")

	w.LogoImage = New("ImageLabel", {
		Size = UDim2.fromOffset(60, 60), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Fit, Image = "", Visible = false, Parent = side,
	})
	w.TitleLabel = Label(w, side, {
		Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 40), Text = w.Title, Font = FONTX, TextSize = 24,
		TextXAlignment = CENTER, TextScaled = true,
	})
	New("UITextSizeConstraint", { MaxTextSize = m and 20 or 26, MinTextSize = 10, Parent = w.TitleLabel })
	w.SubLabel = Label(w, side, { Size = UDim2.new(1, -20, 0, 16), Position = UDim2.fromOffset(10, 72), Text = w.Subtitle, TextSize = 11, TextXAlignment = CENTER }, "SubText")

	w.TabList = New("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -216), Position = UDim2.fromOffset(0, 138), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = AUTOY, Parent = side,
	})
	List(w.TabList, 4)
	Pad(w.TabList, 10, 4, 10, 4)

	-- card do jogador (clicavel)
	local CH = m and 46 or 58
	local AVS = m and 32 or 40
	local card = New("TextButton", {
		Text = "", AutoButtonColor = false, Size = UDim2.new(1, m and -16 or -20, 0, CH), AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, m and 8 or 10, 1, m and -8 or -10), BackgroundTransparency = 0.4, Parent = side,
	})
	w:Bind(card, "BackgroundColor3", "Element")
	Round(card, 10)
	w.Avatar = New("ImageLabel", { Size = UDim2.fromOffset(AVS, AVS), Position = UDim2.fromOffset(m and 7 or 9, (CH - AVS) / 2), BackgroundColor3 = w.Theme.Stroke, Parent = card })
	Round(w.Avatar, AVS / 2)
