-- recalcula tamanho/posicao da janela e o modo da barra lateral.
-- Roda na criacao e toda vez que a tela muda de tamanho (ex.: girar o celular).
function Window:_applyLayout(first)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local inset = GuiService:GetGuiInset()
	local m = self.Mobile
	local W, H
	if m then
		W = (vp.X >= 560) and math.min(self.ReqW, math.floor(vp.X * 0.8)) or (vp.X - 16)
		H = math.min(self.ReqH, vp.Y - inset.Y - 16)
	else
		W = math.min(self.ReqW, vp.X - 24)
		H = math.min(self.ReqH, vp.Y - 24)
	end
	W, H = math.max(W, 240), math.max(H, 200)
	self.W, self.H = W, H

	-- tamanho escolhido no slider, limitado ao que cabe na tela
	if self.MainScale then
		local maxH = m and (vp.Y - inset.Y - 8) or (vp.Y - 8)
		local fit = math.min((vp.X - 8) / W, maxH / H)
		self.MainScale.Scale = math.clamp(self.UserScale, 0.5, math.max(fit, 0.5))
	end

	local narrow = m and W < 520
	if first or self._narrow ~= narrow then
		self._narrow = narrow
		self.SideCollapsed = narrow -- tela estreita comeca com a gaveta fechada
	end
	self.SideOverlay = narrow
	self.SideW = narrow and 150 or (m and 120 or 190)
	self.SideTop = narrow and self.TopH or 0

	self.Main.Size = UDim2.fromOffset(W, H)
	self.Main.Position = UDim2.new(0.5, 0, 0.5, m and math.floor(inset.Y / 2) or 0)
	self.Side.Position = UDim2.fromOffset(0, self.SideTop)
	self.Side.ZIndex = narrow and 20 or 1

	-- caixa de busca encolhe em telas estreitas
	local TB = self.TB
	local cw = narrow and W or (W - self.SideW)
	local avail = cw - (12 + TB + 8) - (12 + TB + 6 + TB + 8)
	self.SearchFrame.Size = UDim2.fromOffset(math.clamp(avail, 90, 210), TB + 2)

	if self.InfoPanel then
		self.InfoPanel.Size = UDim2.fromOffset(math.min(430, W - 20), math.min(340, H - 30))
	end

	self:_applySide(true)
	self:_layoutLogo()
end

------------------------------------------------------------------ janela: config

local FOLDER = "NewlocUI/configs"

local function HasFS()
	return (writefile and readfile and isfile and listfiles and makefolder and isfolder and delfile) and true or false
end

local function EnsureFolders()
	if not isfolder("NewlocUI") then makefolder("NewlocUI") end
	if not isfolder(FOLDER) then makefolder(FOLDER) end
end

local function CleanName(n)
	n = tostring(n or ""):gsub("[^%w_%-]", "")
	return n ~= "" and n or "default"
end

function Window:ExportConfig()
	local data = {}
	for flag, obj in pairs(self.Elements) do
		local ok, v = pcall(obj.Get, obj)
		if ok then data[flag] = v end
	end
	return HttpService:JSONEncode({ version = 1, data = data })
end

function Window:ImportConfig(str)
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, tostring(str))
	if not ok or type(decoded) ~= "table" or type(decoded.data) ~= "table" then return false end
	for flag, v in pairs(decoded.data) do
		local obj = self.Elements[flag]
		if obj then pcall(obj.Set, obj, v) end
	end
	return true
end

function Window:SaveConfig(name)
	if not HasFS() then return false, "Seu executor não suporta arquivos." end
	local ok, err = pcall(function()
		EnsureFolders()
		writefile(FOLDER .. "/" .. CleanName(name) .. ".json", self:ExportConfig())
	end)
	return ok, err
end

function Window:LoadConfig(name)
	if not HasFS() then return false, "Seu executor não suporta arquivos." end
	local path = FOLDER .. "/" .. CleanName(name) .. ".json"
	local ok, content = pcall(function() return isfile(path) and readfile(path) or nil end)
	if not ok or not content then return false, "Config não encontrada." end
	return self:ImportConfig(content)
end

function Window:DeleteConfig(name)
	if not HasFS() then return false end
	local path = FOLDER .. "/" .. CleanName(name) .. ".json"
	return pcall(function() if isfile(path) then delfile(path) end end)
end

function Window:ListConfigs()
	local out = {}
	if not HasFS() then return out end
	pcall(function()
		EnsureFolders()
		for _, p in ipairs(listfiles(FOLDER)) do
			local n = p:match("([^/\\]+)%.json$")
			if n then table.insert(out, n) end
		end
	end)
	table.sort(out)
	return out
end

function Window:ResetAll()
	for _, obj in pairs(self.Elements) do
		if obj.Default ~= nil then pcall(obj.Set, obj, obj.Default) end
	end
end

------------------------------------------------------------------ abas e secoes

function Window:SelectTab(tab)
	if self.Current then self.Current.Page.Visible = false end
	local prev = self.Current
	self.Current = tab
	tab.Page.Visible = true
	if prev then prev:_style() end
	tab:_style()
	if self.SearchBox.Text ~= "" then self.SearchBox.Text = "" end
	self:Search("")
	-- mobile (gaveta): escolheu a aba -> fecha a gaveta
	if self.SideOverlay and not self.SideCollapsed and self.IconClose then
		self:SetSidebarCollapsed(true)
	end
end

function Window:Search(q)
	q = string.lower(q or "")
	local tab = self.Current
	if not tab then return end
	for _, sec in ipairs(tab.Sections) do
		local secMatch = q == "" or string.find(string.lower(sec.Name), q, 1, true) ~= nil
		local any = secMatch
		for _, it in ipairs(sec.Items) do
			local vis = secMatch or string.find(it.name, q, 1, true) ~= nil
			it.frame.Visible = vis
			any = any or vis
		end
		sec.Card.Visible = any
	end
end

function Window:CreateTab(o)
	if type(o) == "string" then o = { Name = o } end
	local w = self
	local m = w.Mobile
	local TH = m and 38 or 40
	local tab = setmetatable({ Window = w, Name = o.Name or "Aba", Sections = {}, IsSettings = o.IsSettings }, Tab)
	table.insert(w.Tabs, tab)

	local btn = New("TextButton", {
		Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, TH), BackgroundTransparency = 1,
		LayoutOrder = o.Order or #w.Tabs, Parent = w.TabList,
	})
	w:Bind(btn, "BackgroundColor3", "Accent")
	Round(btn, 8)
	tab.Btn = btn
	tab.Bar = New("Frame", { Size = UDim2.fromOffset(3, 20), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundTransparency = 1, Parent = btn })
	w:Bind(tab.Bar, "BackgroundColor3", "Accent")
	Round(tab.Bar, 2)

	local iconX = m and 8 or 14
	local nameX = m and 34 or 48
	local icon = tostring(o.Icon or "◆")
	if icon:match("^%d+$") or icon:find("^rbxasset") then
		tab.IconObj = New("ImageLabel", {
			Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(iconX + (m and 0 or 2), (TH - 20) / 2), BackgroundTransparency = 1,
			Image = ResolveImage(icon), Parent = btn,
		})
		tab.IconProp = "ImageColor3"
	else
		tab.IconObj = New("TextLabel", {
			Size = UDim2.fromOffset(24, TH), Position = UDim2.fromOffset(iconX, 0), BackgroundTransparency = 1,
			Text = icon, Font = FONTB, TextSize = 16, Parent = btn,
		})
		tab.IconProp = "TextColor3"
	end
	tab.NameLabel = New("TextLabel", {
		Size = UDim2.new(1, -(nameX + 4), 1, 0), Position = UDim2.fromOffset(nameX, 0), BackgroundTransparency = 1, Text = tab.Name,
		Font = FONTB, TextSize = m and 12 or 13, TextXAlignment = LEFT, TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
	})

	AttachTip(w, tab.NameLabel, function() return tab.Name end, 0, btn)

	local page = New("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = m and 2 or 3,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = AUTOY, Visible = false, Parent = w.Pages,
	})
	w:Bind(page, "ScrollBarImageColor3", "Accent")
	tab.Page = page
	if w.SingleCol then
		-- 1 coluna (mobile): Left e Right sao o mesmo frame
		tab.Left = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTOY, BackgroundTransparency = 1, Parent = page })
		tab.Right = tab.Left
		List(tab.Left, 12)
	else
		tab.Left = New("Frame", { Size = UDim2.new(0.5, -6, 0, 0), AutomaticSize = AUTOY, BackgroundTransparency = 1, Parent = page })
		tab.Right = New("Frame", { Size = UDim2.new(0.5, -6, 0, 0), AutomaticSize = AUTOY, Position = UDim2.new(0.5, 6, 0, 0), BackgroundTransparency = 1, Parent = page })
		List(tab.Left, 12)
		List(tab.Right, 12)
	end
	Pad(page, 0, 0, 6, 8)

	btn.MouseButton1Click:Connect(function() w:SelectTab(tab) end)
	Hover(w, btn,
		function() if w.Current ~= tab then Tween(btn, { BackgroundTransparency = 0.9 }, 0.12) end end,
		function() if w.Current ~= tab then Tween(btn, { BackgroundTransparency = 1 }, 0.12) end end)
	table.insert(w.Refreshers, function() tab:_style() end)
	tab:_style()

	if not w.Current or w.Current.IsSettings then w:SelectTab(tab) end
	return tab
end

function Tab:_style()
	local w = self.Window
	local on = (w.Current == self)
	self.Btn.BackgroundTransparency = on and 0.78 or 1
	self.Bar.BackgroundTransparency = on and 0 or 1
	local c = on and w.Theme.Text or w.Theme.SubText
	self.NameLabel.TextColor3 = c
	self.IconObj[self.IconProp] = on and w.Theme.Accent or c
end

function Tab:CreateSection(o)
	if type(o) == "string" then o = { Name = o } end
	local w = self.Window
	local col
	if o.Side == "Left" then col = self.Left
	elseif o.Side == "Right" then col = self.Right
	else
		self.Flip = not self.Flip
		col = self.Flip and self.Left or self.Right
	end
	local card = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTOY, LayoutOrder = #self.Sections + 1, Parent = col })
	w:Bind(card, "BackgroundColor3", "Card")
	w:AddOpaque(card)
	Round(card, 10)
	local st = Stroke(card, w.Theme.Stroke, 1)
	w:Bind(st, "Color", "Stroke")
	Pad(card, 12, 10, 12, 12)
	List(card, 6)
	local sec = setmetatable({ Window = w, Tab = self, Card = card, Items = {}, Order = 0, Name = o.Name or "" }, Section)
	local titleL = Label(w, card, { Size = UDim2.new(1, 0, 0, 24), Text = sec.Name, Font = FONTB, TextSize = 15, LayoutOrder = 0, TextTruncate = Enum.TextTruncate.AtEnd })
	AttachTip(w, titleL, function() return sec.Name end)
	table.insert(self.Sections, sec)
	return sec
end

------------------------------------------------------------------ secao: base dos elementos

function Section:_next()
	self.Order += 1
	return self.Order
end

function Section:_reg(frame, name)
	table.insert(self.Items, { frame = frame, name = string.lower(tostring(name or "")) })
end

function Section:_row(name, height, parent, reserve)
	local w = self.Window
	local row = New("Frame", {
		Size = UDim2.new(1, 0, 0, height or (w.Mobile and 40 or 34)), BackgroundTransparency = 0.6,
		LayoutOrder = parent and 1 or self:_next(),
	})
	w:Bind(row, "BackgroundColor3", "Element")
	Round(row, 6)
	row.Parent = parent or self.Card
	local label = Label(w, row, {
		Size = reserve and UDim2.new(1, -(reserve + 18), 1, 0) or UDim2.new(0.5, -8, 1, 0),
		Position = UDim2.fromOffset(10, 0), Text = tostring(name or ""),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	AttachTip(w, label, function() return label.Text end, 0, row)
	if not parent then self:_reg(row, name) end
	return row, label
end

-- tamanho dos controles da direita (input, dropdown, seletor): fixo no PC, metade da linha no mobile
function Section:_ctl(desktopW, desktopH)
	if self.Window.Mobile then return UDim2.new(0.5, -12, 0, 30) end
	return UDim2.fromOffset(desktopW, desktopH or 24)
end

function Section:_register(obj, o, default)
	local flag = o.Flag or (self.Tab.Name .. "/" .. tostring(o.Name or default))
	obj.Flag = flag
	obj.Default = obj:Get()
	if o.Save ~= false then self.Window.Elements[flag] = obj end
	self.Window.Flags[flag] = obj:Get()
	return obj
end

local function fire(cb, ...)
	if cb then task.spawn(cb, ...) end
end

