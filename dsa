local lbl = Instance.new("TextLabel")
lbl.Size = UDim2.fromOffset(340, 84)
lbl.Position = UDim2.fromOffset(6, 40)
lbl.BackgroundColor3 = Color3.new(0, 0, 0)
lbl.BackgroundTransparency = 0.4
lbl.TextColor3 = Color3.new(1, 1, 1)
lbl.TextSize = 11
lbl.Font = Enum.Font.Code
lbl.TextXAlignment = Enum.TextXAlignment.Left
lbl.TextYAlignment = Enum.TextYAlignment.Top
lbl.TextWrapped = true
lbl.Active = true
lbl.Parent = gui
lbl.InputBegan:Connect(function(i)
  if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
    lbl.Visible = false
  end
end)

local function fmt(v) return v and "on" or "off" end

task.spawn(function()
  while lbl.Parent and not S.destroyed_flag do
    local n = 0
    for _ in pairs(S.bundles or {}) do n = n + 1 end
    local ch = lp.Character
    local tool = ch and ch:FindFirstChildOfClass("Tool")
    local hasCfg = tool and tool:FindFirstChild("Cfg") ~= nil
    local v562 = g.v562
    local fnOk = v562 and (v562.fn ~= nil) or false
    lbl.Text = string.format(
      "ESP %s box %s nome %s hl %s | alvos %d\n" ..
      "muni %s fn %s | arma %s cfg %s\n" ..
      "walk %s fly %s aim %s | drawing %s\n" ..
      "err: %s",
      fmt(S.espEnabled), fmt(S.box), fmt(S.name), fmt(S.highlight), n,
      fmt(S.armaInfAmmo), tostring(fnOk), tool and tool.Name or "-", tostring(hasCfg),
      fmt(S.spoofWalkEnabled), fmt(S.flyEnabled), fmt(S.aimbotEnabled), tostring(drawingOk),
      tostring(rt.espErro or "nenhum")
    )
    task.wait(0.5)
  end
end)

print("[MobileFix] ativo | mobile = " .. tostring(mobile))
