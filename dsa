      CloseOnOutsideClick = false, Mobile = mobile, SingleColumn = mobile,
      FloatButton = true })
    W.Native = NW
    pcall(NW.SetTitle, NW, "Grand Menu")
    pcall(NW.SetSubtitle, NW, o.Subtitle or "")

    function W:_track(c)
      table.insert(self._conns, c)
      return c
    end

    -- botao flutuante (o hub pendura HUDs no .Parent dele)
    local gui = Instance.new("ScreenGui")
    gui.Name = "GrandMenuFloat"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 50
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
    local okHui, hui = pcall(function() return gethui and gethui() end)
    gui.Parent = (okHui and hui) or coreGui
    -- nenhum botao aparece: o hub so precisa de um objeto invisivel para pendurar os HUDs dele
    local btn = Instance.new("TextButton")
    btn.Name = "FloatingButton"
    btn.Size = UDim2.fromOffset(0, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Active = false
    btn.AutoButtonColor = false
    btn.Visible = false
    btn.Parent = gui
    W._floatingEnabled = false
    W.FloatingButton = btn
    W.Gui = gui

    -- ---------------------------------------------------------------- autosave
    -- Salva TUDO (toggles, sliders, dropdowns, teclas, tecla de minimizar, cores, opacidade, tamanho...)
    -- e carrega sozinho ao executar. Arquivo: NewlocUI/configs/grandmenu.json
    local AUTOSAVE = "grandmenu"
    local saveQueued = false
    local function queueSave()
      if not W._loaded or saveQueued then return end
      saveQueued = true
      task.delay(2, function()
        saveQueued = false
        if W._alive then pcall(NW.SaveConfig, NW, AUTOSAVE) end
      end)
    end

    -- "foto" do estado atual de todos os controles salvaveis (ordem fixa, para comparar)
    local function snapshot()
      local keys = {}
      for k in pairs(NW.Elements or {}) do keys[#keys + 1] = k end
      table.sort(keys)
      local parts = {}
      for _, k in ipairs(keys) do
        local el = NW.Elements[k]
        local ok, v = pcall(el.Get, el)
        parts[#parts + 1] = k .. "=" .. (ok and httpService:JSONEncode({ v }) or "?")
      end
      return table.concat(parts, "\n")
    end

    function W:_loadSaved()
      if self._loaded then return end
      self._loaded = true
      pcall(NW.LoadConfig, NW, AUTOSAVE)
      self._lastSnap = snapshot()
      -- a UI nova nao avisa quando uma opcao da propria lib muda (cores, tecla do menu, tamanho...);
      -- entao a cada 3s comparamos o estado e salvamos se algo mudou
      task.spawn(function()
        while self._alive do
          task.wait(3)
          local cur = snapshot()
          if cur ~= self._lastSnap then
            self._lastSnap = cur
            pcall(NW.SaveConfig, NW, AUTOSAVE)
          end
        end
      end)
    end

    function W:SetVisible(v)
      v = v and true or false
      self._visible = v
      pcall(NW.SetState, NW, v and "open" or "hidden")
      if v then self:_loadSaved() end
    end
    -- se o hub falhar no meio da montagem e nunca chamar SetVisible, carrega mesmo assim
    task.delay(15, function()
      if W._alive then W:_loadSaved() end
    end)
    function W:Toggle()
      self:SetVisible(not (NW.State == "open"))
    end

    function W:Notify(n)
      n = n or {}
      pcall(NW.Notify, NW, { Title = tostring(n.Title or "Grand Menu"),
        Content = tostring(n.Text or n.Content or ""), Duration = n.Duration or 4 })
    end

    function W:Destroy()
      if not self._alive then return end
      self._alive = false
      for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
      pcall(NW.Destroy, NW)
      pcall(function() gui:Destroy() end)
      for i, w in ipairs(Lib.Windows) do if w == self then table.remove(Lib.Windows, i) break end end
    end

    -- --------------------------------------------------------- elementos
    local function wrapCb(cb)
      return function(...)
        call(cb, ...)
        queueSave()
      end
    end

    local function addItem(sec, kind, o2)
      if kind == "Label" and type(o2) == "string" then o2 = { Text = o2 } end
      o2 = type(o2) == "table" and o2 or {}
      local ns = sec.Native
      local name = tostring(o2.Text or o2.Title or kind)
      local flag = (not o2.NoFlag) and o2.Flag or nil
      if not flag and not o2.NoFlag and (kind == "Toggle" or kind == "Slider" or kind == "Textbox"
        or kind == "Keybind" or kind == "ColorPicker" or (kind == "Dropdown" and o2.Multi == true)) then
        local base = "gm/" .. tostring(sec.Sub and sec.Sub.Name or "?") .. "/" .. tostring(sec.Title) .. "/" .. name
        W._flagN = W._flagN or {}
        W._flagN[base] = (W._flagN[base] or 0) + 1
        flag = base .. (W._flagN[base] > 1 and ("#" .. W._flagN[base]) or "")
      end
      local h = { Kind = kind, Opt = o2, Section = sec }
      local nObjs = #ns.Items

      h.Instance = makeProxy(function(k)
        if k == "Parent" then
          if h.Frame then return h.Frame.Parent end
          return W._alive and gui or nil
        elseif k == "Visible" then
          return h.Frame and h.Frame.Visible or h._visible ~= false
        end
      end, function(k, v)
        if k == "Visible" then h:SetVisible(v) end
      end)

      local ok, obj = pcall(function()
        if kind == "Toggle" then
          return ns:CreateToggle({ Name = name, CurrentValue = o2.Default == true, Flag = flag,
            Callback = wrapCb(o2.Callback) })
        elseif kind == "Slider" then
          local mn, mx = tonumber(o2.Min) or 0, tonumber(o2.Max) or 100
          return ns:CreateSlider({ Name = name, Range = { mn, mx }, Increment = tonumber(o2.Step) or 1,
            Suffix = o2.Suffix, CurrentValue = clamp(tonumber(o2.Default) or mn, mn, mx), Flag = flag,
            Callback = wrapCb(o2.Callback) })
        elseif kind == "Dropdown" then
          h.options = {}
          for _, v in ipairs(o2.Options or {}) do table.insert(h.options, tostring(v)) end
          if o2.Multi == true then
            -- UI nova so tem dropdown simples: cada opcao vira "[x] nome" / "[  ] nome"
            local sel = {}
            for _, v in ipairs(type(o2.Default) == "table" and o2.Default or {}) do sel[tostring(v)] = true end
            h.sel = sel
            local cb = wrapCb(o2.Callback)
            local dd
            local function deco()
              h.map = {}
              local t = {}
              for _, op in ipairs(h.options) do
                local pl = plain(op)
                h.map[pl] = op
                t[#t + 1] = (sel[op] and "[x] " or "[  ] ") .. pl
              end
              return t
            end
            local function summary()
              local n = 0
              for _, op in ipairs(h.options) do if sel[op] then n = n + 1 end end
              return n == 0 and "Nenhum" or (n .. " selecionado(s)")
            end
            function h._selected()
              local t = {}
              for _, op in ipairs(h.options) do if sel[op] then t[#t + 1] = op end end
              return t
            end
            function h._refreshMulti()
              pcall(dd.SetOptions, dd, deco())
              pcall(dd.Set, dd, summary(), true)
            end
            dd = ns:CreateDropdown({ Name = name, Options = deco(), CurrentValue = summary(),
              CloseOnSelect = false, Save = false,
              Callback = function(v)
                local pl = tostring(v):match("^%[[x ]+%]%s*(.*)$") or tostring(v)
                local opt = h.map and h.map[pl] or pl
                sel[opt] = not sel[opt] or nil
                h._refreshMulti()
                cb(h._selected())
              end })
            h._fireMulti = function() cb(h._selected()) end
            h._setSel = function(list)
              for k in pairs(sel) do sel[k] = nil end -- mesma tabela que deco()/summary() usam
              for _, x in ipairs(type(list) == "table" and list or {}) do sel[tostring(x)] = true end
            end
            -- entra na config salva (Save = false acima so impede o registro automatico, que guardaria o texto do resumo)
            if flag and NW.Elements then
              NW.Elements[flag] = {
                Default = {},
                Get = function() return h._selected() end,
                Set = function(_, v)
                  h._setSel(v)
                  h._refreshMulti()
                  h._fireMulti()
                end,
              }
            end
            return dd
          end
          local function remap()
            h.map = {}
            local out = {}
            for _, v in ipairs(h.options) do
              local pl = plain(v)
              h.map[pl] = v
              out[#out + 1] = pl
            end
            return out
          end
          h._remap = remap
          local shown = remap()
          local cur = o2.Default ~= nil and plain(o2.Default) or nil
          local cb = wrapCb(o2.Callback)
          return ns:CreateDropdown({ Name = name, Options = shown, CurrentValue = cur, Flag = flag,
            Save = flag ~= nil, Callback = function(v) cb(h.map[v] or v) end })
        elseif kind == "Textbox" then
          return ns:CreateInput({ Name = name, Placeholder = o2.Placeholder, CurrentValue = tostring(o2.Default or ""),
            Flag = flag, Callback = wrapCb(o2.Callback) })
        elseif kind == "Keybind" then
          local kc = toEnumKey(o2.Default)
          return ns:CreateKeybind({ Name = name, CurrentValue = kc, Flag = flag,
            Callback = o2.Callback and function() call(o2.Callback) end or nil,
            OnChanged = function(key)
              call(o2.OnChanged, { Key = key or Enum.KeyCode.Unknown, Ctrl = false, Shift = false, Alt = false })
              queueSave()
            end })
