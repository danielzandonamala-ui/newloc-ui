  -- ---------------------------------------------------------------- config
  local function fn(name)
    local f = genv[name]
    return type(f) == "function" and f or nil
  end

  local function ensureFolder(path)
    local isfolder, makefolder = fn("isfolder"), fn("makefolder")
    if not (isfolder and makefolder) then return false end
    local cur = ""
    for part in string.gmatch(path, "[^/]+") do
      cur = cur == "" and part or cur .. "/" .. part
      local ok, exists = pcall(isfolder, cur)
      if not ok then return false end
      if not exists then pcall(makefolder, cur) end
    end
    return true
  end

  local function cleanName(s)
    return (tostring(s or ""):gsub("[^%w%-_ ]", ""):gsub("^%s+", ""):gsub("%s+$", ""))
  end

  local function cfgPath(name) return Lib.Config.Folder .. "/" .. name .. ".json" end

  function Lib.Config.isSupported()
    return fn("writefile") ~= nil and fn("readfile") ~= nil and fn("isfolder") ~= nil
  end

  function Lib.Config.list()
    local out = {}
    local listfiles = fn("listfiles")
    if not listfiles or not Lib.Config.isSupported() then return out end
    ensureFolder(Lib.Config.Folder)
    local ok, files = pcall(listfiles, Lib.Config.Folder)
    if not ok or type(files) ~= "table" then return out end
    for _, path in ipairs(files) do
      local name = tostring(path):match("([^/\\]+)%.json$")
      if name then table.insert(out, name) end
    end
    table.sort(out)
    return out
  end

  function Lib.Config.save(name, data)
    name = cleanName(name)
    if name == "" then return false, "nome invalido" end
    if not Lib.Config.isSupported() then return false, "executor sem filesystem" end
    if not ensureFolder(Lib.Config.Folder) then return false, "falha ao criar pasta" end
    local ok, json = pcall(httpService.JSONEncode, httpService, data or {})
    if not ok then return false, "falha ao serializar" end
    if not pcall(fn("writefile"), cfgPath(name), json) then return false, "falha ao escrever" end
    return true
  end

  function Lib.Config.load(name)
    name = cleanName(name)
    if name == "" or not Lib.Config.isSupported() then return nil, "nome invalido ou sem filesystem" end
    local isfile = fn("isfile")
    if isfile and not isfile(cfgPath(name)) then return nil, "config nao existe" end
    local ok, raw = pcall(fn("readfile"), cfgPath(name))
    if not ok then return nil, "config nao existe" end
    local ok2, data = pcall(httpService.JSONDecode, httpService, raw)
    if not ok2 or type(data) ~= "table" then return nil, "arquivo corrompido" end
    return data
  end

  function Lib.Config.delete(name)
    name = cleanName(name)
    local delfile = fn("delfile")
    if name == "" or not delfile then return false, "nome invalido ou sem filesystem" end
    if not pcall(delfile, cfgPath(name)) then return false, "falha ao apagar" end
    return true
  end

