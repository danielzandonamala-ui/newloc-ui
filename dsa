  -- ---------------------------------------------------------------- window
  function Lib:CreateWindow(o)
    o = o or {}
    local UIL = loadUI()
    local W = { Theme = Theme, Pages = {}, _conns = {}, _alive = true, _visible = true,
      _floatingEnabled = true, _loaded = false }

    local mobile = userInputService.TouchEnabled
