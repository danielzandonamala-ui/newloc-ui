  -- objeto "absorvente": aceita qualquer set/get sem quebrar o codigo do hub
  -- que mexe em .Instance / .Label (Rayfield nao expoe esses frames).
  local function makeProxy(getter, setter)
    local store = {}
    local proxy
    proxy = setmetatable({}, {
      __index = function(_, k)
        if getter then
          local v = getter(k)
          if v ~= nil then return v end
        end
        if store[k] ~= nil then return store[k] end
        if k == "FindFirstChildWhichIsA" or k == "FindFirstChildOfClass" then
          return function() return makeProxy() end
        elseif k == "FindFirstChild" then
          return function() return nil end
        elseif k == "GetChildren" or k == "GetDescendants" then
          return function() return {} end
        elseif k == "SetAttribute" or k == "Destroy" or k == "GetAttribute" then
          return function() end
        elseif k == "GetPropertyChangedSignal" then
          return function()
            return { Connect = function() return { Disconnect = function() end } end }
          end
        end
        return nil
      end,
      __newindex = function(_, k, v)
        store[k] = v
        if setter then setter(k, v) end
      end,
    })
    return proxy
  end

  local function keyName(v, depth)
    depth = depth or 0
    if typeof(v) == "EnumItem" then return v.Name end
    if type(v) == "string" then return v end
    if type(v) == "table" and depth < 2 then return keyName(v.Key, depth + 1) end
    return nil
  end

  -- aceita EnumItem (KeyCode ou UserInputType, ex.: MouseButton2) ou nome de tecla
  local function toEnumKey(v)
    if typeof(v) == "EnumItem" then return v end
    local n = keyName(v)
    if not n then return nil end
    local ok, kc = pcall(function() return Enum.KeyCode[n] end)
    if ok and kc then return kc end
    local ok2, ui = pcall(function() return Enum.UserInputType[n] end)
    if ok2 and ui then return ui end
    return nil
  end

  -- o hub monta textos com <font color=...>; a lib nao renderiza, entao mostramos texto puro
  local function plain(v) return (tostring(v):gsub("<[^>]*>", "")) end

  local function clamp(v, lo, hi) return math.max(lo, math.min(hi, v)) end

